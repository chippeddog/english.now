# URL of the API server, reachable from your device (use your LAN IP, not localhost)
EXPO_PUBLIC_SERVER_URL=http://192.168.1.10:3000
# Web app URL used for email verification and password reset links
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3001
# Web OAuth client ID (same value as GOOGLE_CLIENT_ID on the server)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID, e.g. 1234-abcd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
