EXPO_PUBLIC_SERVER_URL=
# Web app URL used for email verification and password reset links
EXPO_PUBLIC_WEB_URL=https://english.now
# Web OAuth client ID (same value as GOOGLE_CLIENT_ID on the server)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID, e.g. 1234-abcd.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
