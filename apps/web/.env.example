# Required: URL of the API server (apps/server)
VITE_SERVER_URL=http://localhost:3000

# Public URL of this web app (canonical links, sitemap). Optional locally.
VITE_APP_URL=http://localhost:3001

# Paddle billing (optional; must match the server's Paddle setup)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_PRICE_MONTHLY=
VITE_PADDLE_PRICE_YEARLY=

# PostHog product analytics (optional)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Sentry (optional)
VITE_SENTRY_DSN=
# Build-only values for source map uploads. Do not expose the token in client code.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
