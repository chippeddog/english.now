# Database
DATABASE_URL=postgresql://username:password@localhost:5432/english_now

# Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# iOS bundle ID; enables native Sign in with Apple from the Expo app
APPLE_APP_BUNDLE_IDENTIFIER=now.english.app

# Cloudflare R2 Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=english-now-avatars
R2_PUBLIC_URL=https://your-public-r2-domain.com

# AI Services
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

# Langfuse AI observability (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Email (AutoSend)
EMAIL_FROM=
AUTOSEND_API_KEY=
AUTOSEND_RESET_PASSWORD_TEMPLATE_ID=
AUTOSEND_VERIFY_EMAIL_TEMPLATE_ID=

# Optional; defaults to hello@english.now
# CONTACT_INBOX_EMAIL=

# Paddle Payments
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Server
PORT=3000
NODE_ENV=development

# Sentry (optional)
# Set SENTRY_DSN to enable server-side error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Set to a value from 0 to 1 to enable performance traces, e.g. 0.1 in production.
SENTRY_TRACES_SAMPLE_RATE=

# CORS
CORS_ORIGIN=http://localhost:5173