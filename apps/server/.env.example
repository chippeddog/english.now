# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Matches docker-compose.yml (`docker compose up -d`)
DATABASE_URL=postgresql://english_now:english_now@localhost:5432/english_now

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-characters-long
# Public URL of this API server
BETTER_AUTH_URL=http://localhost:3000
# Origin of the web app (apps/web runs on port 3001)
CORS_ORIGIN=http://localhost:3001

# Powers conversations, feedback, lessons and grammar. Also used for
# speech-to-text and text-to-speech when Deepgram is not configured.
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment (production)
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the web app, added to trusted auth origins
APP_URL=
# Parent domain for cookies shared by the web app and API, e.g. .english.now
# Leave empty locally. Required in production when web and API are on subdomains.
COOKIE_DOMAIN=
PORT=3000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations — features that need a missing one are hidden
# ─────────────────────────────────────────────────────────────────────────────

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple sign-in
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# iOS bundle ID; enables native Sign in with Apple from the Expo app
APPLE_APP_BUNDLE_IDENTIFIER=

# Deepgram: live transcription for read-aloud practice, faster speech services
DEEPGRAM_API_KEY=

# Azure Speech: pronunciation scoring (read-aloud practice needs Azure + Deepgram)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Cloudflare R2 storage for audio and avatars.
# Without it, files are stored on local disk in LOCAL_STORAGE_DIR and served at /files.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
LOCAL_STORAGE_DIR=storage

# Email (AutoSend). Without it, sign-up skips email verification and
# emails (password reset links, contact form) are printed to the server log.
AUTOSEND_API_KEY=
AUTOSEND_RESET_PASSWORD_TEMPLATE_ID=
AUTOSEND_VERIFY_EMAIL_TEMPLATE_ID=
EMAIL_FROM=
CONTACT_INBOX_EMAIL=

# Paddle billing. Without it, every learner gets unlimited access (self-hosted mode).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# Langfuse AI observability
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 to 1, e.g. 0.1 in production
SENTRY_TRACES_SAMPLE_RATE=
